# Production URL (no trailing slash). Enables canonical URL, sitemap and robots host.
NEXT_PUBLIC_SITE_URL=

# EmailJS — used server-side by the contact form (app/actions/contact.ts).
# These are the same service/template the intalk.ai site uses.
# In EmailJS: Account → Security → enable "Allow EmailJS API for non-browser applications".
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Only required if "Use Private Key" is enabled in EmailJS (recommended for server calls).
EMAILJS_PRIVATE_KEY=
